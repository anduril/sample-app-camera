# Copy to `.env` and fill in real values. Never commit `.env`.

# Lattice environment hostname, NO scheme (e.g. my-env.env.sandboxes.developer.anduril.com
# or an on-prem IP/host). Do not include https://.
LATTICE_ENDPOINT=

# --- Authentication -------------------------------------------------------
# Provide EITHER a static bearer token OR OAuth2 client credentials.
# If both are set, the static token is used.

# Static long-lived bearer token (preferred when present).
ENVIRONMENT_TOKEN=

# OAuth2 client credentials (used when ENVIRONMENT_TOKEN is empty).
CLIENT_ID=
CLIENT_SECRET=

# Account-level Sandbox authorization token. Additive; sent on every call.
# Leave empty for non-Sandbox environments.
SANDBOXES_TOKEN=

# --- TLS / connecting at the edge ----------------------------------------
# To connect to an offline / air-gapped Lattice environment whose private
# Anduril CA is not in your system trust store, set this to the path of the
# Anduril-issued CA certificate (PEM). This is the recommended approach: TLS
# verification stays fully enabled. Obtain the certificate from your Anduril
# representative.
LATTICE_CA_CERT_PATH=

# --- Camera entity --------------------------------------------------------
# Entity id: must be a UUID (Lattice validates asset ids) and must stay the
# same across restarts. Leave it empty and the daemon uses, in order: the id
# recorded in STATE_FILE by the previous run, else a UUID derived from this
# Pi's hardware serial (stable across reinstalls), else a random UUID kept in
# STATE_FILE. Set it only to pin a specific id or move it between boards.
ENTITY_ID=
ENTITY_NAME=RPi Camera
PLATFORM_TYPE=Camera
INTEGRATION_NAME=lattice-cam
# Flag state published as mil_view.nationality: an SDK Nationality member name
# such as UNITED_STATES_OF_AMERICA, UNITED_KINGDOM or GERMANY (checked at startup).
NATIONALITY=UNITED_STATES_OF_AMERICA
# One aliases.alternate_ids entry so other systems can correlate this asset.
# Leave ALTERNATE_ID empty to use the Pi's hardware serial from /proc/cpuinfo.
# ALTERNATE_ID_TYPE is an SDK AltIdType member name (SERIAL_NUMBER,
# REGISTRATION_ID, CALLSIGN, ...); avoid ASSET_ID, it collides with entity_id.
ALTERNATE_ID=
ALTERNATE_ID_TYPE=SERIAL_NUMBER

# The camera's fixed location (it does not move). SET THESE for your site.
CAMERA_LATITUDE=49.65108
CAMERA_LONGITUDE=11.79045
CAMERA_ALTITUDE_HAE_METERS=1048.0

# --- Persistent state -----------------------------------------------------
# Small JSON file holding what must outlive the process: the current video
# ingress (so a restart can archive one the previous process never cleaned
# up) and the entity's created_time. Must be writable by the service user.
STATE_FILE=./state.json

# --- Video (Lattice VideoManager SRT ingress) -----------------------------
# When enabled, the service registers an SRT ingress stream with Lattice at
# startup, advertises the returned video id on the entity (Media -> MediaItem),
# and writes the SRT push URL to SRT_TARGET_FILE for MediaMTX to consume.
VIDEO_ENABLED=true
VIDEO_TITLE=
# Optional SRT passphrase for the ingress (leave empty for none).
SRT_PASSPHRASE=
# EnvironmentFile the MediaMTX unit loads (written as SRT_TARGET=<srt url>).
SRT_TARGET_FILE=./srt_target.env
# MediaMTX control API (api: yes in mediamtx.yml) used to observe whether the
# camera path is producing frames and whether the SRT pusher is attached.
MEDIAMTX_API_URL=http://127.0.0.1:9997
# Name of the MediaMTX path the camera publishes to.
MEDIAMTX_PATH=cam

# --- Tasking (Lattice Tasks API) ------------------------------------------
# When enabled, the entity advertises a task_catalog with the custom Start or
# Stop task (task-def/), whichever would change the stream's current state,
# and the service listens for tasks routed to it.
TASKING_ENABLED=true
# Protobuf package of the task definitions pushed to the Lattice Schema
# Registry. Must match the `package` line in task-def/**/camera_tasks.proto.
# Type URLs become type.googleapis.com/<TASK_PACKAGE>.Start and .Stop.
TASK_PACKAGE=anduril.sample_app_rpi_cam.camera.v1alpha
# Shell commands that bring the MediaMTX SRT push up and down. Every Start
# first registers a NEW ingress with Lattice and rewrites SRT_TARGET_FILE, then
# runs TASK_START_COMMAND, so use `systemctl restart` (not `start`) to make
# MediaMTX re-read the file. Every Stop runs TASK_STOP_COMMAND and then
# archives the ingress in Lattice (DeleteIngressStream). Leave both empty for
# state-only transitions off the Pi (the ingress is still created/archived
# when VIDEO_ENABLED=true). The daemon runs unprivileged, so the service user
# needs a sudoers rule for exactly these commands; the repo ships one in
# deploy/sudoers.d/lattice-cam:
#   <service-user> ALL=(root) NOPASSWD: /usr/bin/systemctl restart mediamtx-srt, /usr/bin/systemctl stop mediamtx-srt
# sudo matches the full command line, so the values here MUST be byte-identical
# to that rule (`sudo systemctl restart mediamtx-srt` / `sudo systemctl stop
# mediamtx-srt`): no extra flags, spaces or a different unit name.
TASK_START_COMMAND=
TASK_STOP_COMMAND=
# Values for the Pi, matching the shipped sudoers rule:
# TASK_START_COMMAND=sudo systemctl restart mediamtx-srt
# TASK_STOP_COMMAND=sudo systemctl stop mediamtx-srt
# Heartbeat interval requested on the agent stream (ms). Must be >= 1000 while
# TASKING_ENABLED=true: the health "tasking" component uses heartbeats to tell
# a quiet stream from a dead one.
TASK_HEARTBEAT_INTERVAL_MS=30000

# --- Health telemetry -----------------------------------------------------
# When enabled, a background sampler probes the Pi every
# HEALTH_SAMPLE_INTERVAL_SECONDS (SoC temperature and `vcgencmd get_throttled`
# flags, power supply, media pipeline via the MediaMTX API, task stream,
# load/memory/disk) and the entity carries per-component Health plus alerts.
# When disabled the entity still publishes Health, reported NOT_READY, so an
# operator can see that nothing is being sampled.
HEALTH_ENABLED=true
# Sampling period in seconds (minimum 0.5). Probes never run on the 1 Hz
# publish tick; the entity carries the last sample.
HEALTH_SAMPLE_INTERVAL_SECONDS=5.0
# SoC temperature thresholds in °C for the soc-thermal component: WARN at or
# above HEALTH_TEMP_WARN_C, FAIL at or above HEALTH_TEMP_FAIL_C (must be
# greater than warn). The firmware's own throttle flags raise the status
# regardless of these thresholds.
HEALTH_TEMP_WARN_C=75.0
HEALTH_TEMP_FAIL_C=85.0
