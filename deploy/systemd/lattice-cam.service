# systemd unit for the Lattice camera daemon.
#
# Install (or run `make install-units` from the repo root):
#   sudo install -m 0644 deploy/systemd/lattice-cam.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lattice-cam
#
# PLACEHOLDERS: @INSTALL_DIR@ is the checkout path and @SERVICE_USER@ the
# unprivileged account that runs the daemon. `make install-units` renders both
# (defaults: the current directory and the invoking user; override with
# `make install-units INSTALL_DIR=/opt/lattice-cam SERVICE_USER=rpi-cam`).
# The account must own the checkout (the daemon writes srt_target.env and
# state.json there) and must match the sudoers rule in
# deploy/sudoers.d/lattice-cam.

[Unit]
Description=lattice-cam - publishes the Pi camera as a Lattice entity (gRPC/Connect)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run unprivileged. The daemon only needs to reach Lattice, write two small
# files in its project directory and call `sudo systemctl restart|stop
# mediamtx-srt`, which the sudoers rule allows without a password.
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
# Runs the console script from the project's virtualenv. --config points at the
# .env file; alternatively drop the file and use EnvironmentFile= below.
ExecStart=@INSTALL_DIR@/.venv/bin/lattice-cam --config @INSTALL_DIR@/.env
# Or inject credentials/config via systemd instead of a .env file:
# EnvironmentFile=/etc/lattice-cam/env

Restart=always
RestartSec=5

# Graceful shutdown: the service handles SIGTERM and drains within 30s.
# Shutdown budget: stop MediaMTX (its own unit stops within 10 s), archive
# the ingress (30 s RPC timeout), publish the entity offline, join the
# publisher. Must exceed the worst case so SIGKILL never skips the archive.
TimeoutStopSec=120

# Hardening. Chosen to stay compatible with the sudo call the Start/Stop tasks
# make (TASK_START_COMMAND / TASK_STOP_COMMAND):
#   - NoNewPrivileges=yes is deliberately NOT set: it forbids the setuid
#     transition sudo relies on, so every Start/Stop task would fail.
#   - ProtectHome= is NOT set: the project lives under /home.
#   - ProtectSystem=strict is NOT used: it would make the project directory
#     read-only; =full only protects /usr, /boot, /efi and /etc.
# After installing, confirm sudo still works from inside the unit:
#   grep NoNewPrivs /proc/$(systemctl show -p MainPID --value lattice-cam)/status
# must print "NoNewPrivs: 0".
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
